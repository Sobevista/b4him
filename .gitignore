# tools/release.py refuses to publish on a dirty tree, so anything a run leaves behind must be ignored here.
__pycache__/
.pytest_cache/
# The release heartbeat: one line per run on this machine. Local evidence, not site content.
release_log.jsonl
# A failed run's tile for the harness app (written by release.py on FAIL, removed by the next good run).
release_alarm.md
# The scheduled task's console output (tools/daily.cmd).
release_task_output.log
# The real names behind the people registry (tools/people_registry.py reads it when present). b4him is public: never commit it.
data/people_names.local.json
# The live capability inventory names this machine's tasks and paths: local evidence, never committed to a public repo.
tools/capability_inventory/output/
